{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        

        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run selected script (prompt)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/${input:pythonScript}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: pytest (run workspace tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "PHP: Listen for Xdebug (Attach)",
            "type": "node",
            "request": "launch",
            "port": 9003,
            "stopOnEntry": false,
            "pathMappings": {
                "/var/www/html": "${workspaceFolder}",
                "f:\\\\Dropbox\\\\Site AppsGroup": "${workspaceFolder}"
            }
        },
        {
            "name": "PHP: Launch current script with Xdebug",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "-dxdebug.mode=develop,debug",
                "-dxdebug.start_with_request=yes"
            ],
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "port": 9003
        },
        {
            "name": "PHP: Launch selected script (pick)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "-dxdebug.mode=develop,debug",
                "-dxdebug.start_with_request=yes"
            ],
            "program": "${workspaceFolder}/${input:phpScript}",
            "cwd": "${workspaceFolder}",
            "port": 9003
        }
    ],
    "inputs": [
        {
            "id": "pythonScript",
            "type": "promptString",
            "description": "Relative path to Python script to debug (e.g. scripts/myscript.py)",
            "default": ""
        },
        {
            "id": "phpScript",
            "type": "pickString",
            "description": "Select PHP script to launch with Xdebug (generated by script)",
            "options": [
                "enviar.php",
                "phpmailer/class.phpmailer.php",
                "class.phpmailer.php",
                "class.smtp.php",
                "PHPMailerAutoload.php",
                "Obsoleto/AppsGroup/enviar.php",
                "phpmailer/class.pop3.php"
            ]
        }
    ],
    "generatePHPInputs": {
        "command": "powershell.exe",
        "args": [
            "-file",
            ".vscode/generate-php-inputs.ps1"
        ],
        "description": "Generate PHP inputs for the current workspace"
    },
    "variables": {
        "found": "true"
    }
}