{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "name": "Launch Extension",
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "npm",
            "request": "launch",
            "type": "extensionHost"
        },
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Python: Arquivo Atual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Executar script selecionado (prompt)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/${input:pythonScript}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: pytest (testes do workspace)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q"
            ],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "pythonScript",
            "type": "promptString",
            "description": "Caminho relativo do script Python a depurar (ex.: scripts/myscript.py)",
            "default": ""
        },
        {
            "id": "phpScript",
            "type": "pickString",
            "description": "Selecione o script PHP a executar com Xdebug",
            "options": [
                "class.phpmailer.php",
                "class.smtp.php",
                "enviar.php",
                "PHPMailerAutoload.php",
                "phpmailer/class.phpmailer.php",
                "phpmailer/class.pop3.php",
                "phpmailer/class.smtp.php"
            ]
        }
    ],
    "generatePHPInputs": {
        "command": "powershell.exe",
        "args": [
            "-file",
            ".vscode/generate-php-inputs.ps1"
        ],
        "description": "Gerar lista de scripts PHP para o workspace atual"
    },
    "variables": {
        "found": "true"
    }
}