APP_ENV=development

# SMTP server configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USERNAME=contato@example.com
SMTP_PASSWORD=CHANGE_ME

# From and recipients
SMTP_FROM=contato@example.com
SMTP_FROM_NAME=Contato AppsGroup
# Comma-separated list of recipients
SMTP_TO=mateus@agenciasmall.com.br

# Debug level (0-4)
SMTP_DEBUG=0

